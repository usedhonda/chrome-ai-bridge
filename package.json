{
  "name": "chrome-ai-bridge",
  "version": "3.0.0",
  "description": "Project-aware ChatGPT Pro and Gemini Thinking workflows driven by the browser tools of Claude Code or Codex.",
  "type": "module",
  "bin": {
    "chrome-ai-bridge": "./scripts/cli.mjs",
    "cab": "./scripts/cab",
    "ask-ai": "./skills/ask-ai/scripts/ask-ai"
  },
  "main": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "npm run build && node --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier --write .",
    "check-format": "eslint . && prettier --check .",
    "docs": "node scripts/check-browser-docs.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "build",
    "!build/**/*.tsbuildinfo",
    "scripts/cli.mjs",
    "scripts/cab",
    "skills/ask-ai",
    "!skills/ask-ai/*.local.md",
    "docs/*.md",
    "docs/user",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usedhonda/chrome-ai-bridge.git"
  },
  "author": "usedhonda (forked from Google LLC)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/usedhonda/chrome-ai-bridge/issues"
  },
  "homepage": "https://github.com/usedhonda/chrome-ai-bridge#readme",
  "keywords": [
    "browser-use",
    "chatgpt",
    "gemini",
    "claude-code",
    "codex",
    "ai-bridge",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.3",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./build/index.d.ts"
}
